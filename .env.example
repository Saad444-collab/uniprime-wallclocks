# =============================================================
#  UniPrime Wall Clocks - Environment Configuration
# =============================================================
#  Copy this file to .env (server/.env) and fill in your own values.
#  NEVER commit real credentials. All values below are placeholders.

NODE_ENV=development
PORT=5000

# --- 8-cluster MongoDB Atlas configuration ---
# Each cluster should be its own independent MongoDB Atlas Free (512MB) cluster.
# Create your own Atlas clusters and paste your connection strings here.
# If MONGO_CLUSTER_N_URI is left empty, the application falls back to MONGODB_URI
# with a per-cluster database name (MONGO_DB_NAME_CLUSTER_N).
MONGO_CLUSTER_1_URI=mongodb+srv://USER:PASSWORD@cluster0.example1.mongodb.net/
MONGO_CLUSTER_2_URI=mongodb+srv://USER:PASSWORD@cluster0.example2.mongodb.net/
MONGO_CLUSTER_3_URI=mongodb+srv://USER:PASSWORD@cluster0.example3.mongodb.net/
MONGO_CLUSTER_4_URI=mongodb+srv://USER:PASSWORD@cluster0.example4.mongodb.net/
MONGO_CLUSTER_5_URI=mongodb+srv://USER:PASSWORD@cluster0.example5.mongodb.net/
MONGO_CLUSTER_6_URI=mongodb+srv://USER:PASSWORD@cluster0.example6.mongodb.net/
MONGO_CLUSTER_7_URI=mongodb+srv://USER:PASSWORD@cluster0.example7.mongodb.net/
MONGO_CLUSTER_8_URI=mongodb+srv://USER:PASSWORD@cluster0.example8.mongodb.net/

MONGO_DB_NAME_CLUSTER_1=uniprime_wall_clocks_c1
MONGO_DB_NAME_CLUSTER_2=uniprime_wall_clocks_c2
MONGO_DB_NAME_CLUSTER_3=uniprime_wall_clocks_c3
MONGO_DB_NAME_CLUSTER_4=uniprime_wall_clocks_c4
MONGO_DB_NAME_CLUSTER_5=uniprime_wall_clocks_c5
MONGO_DB_NAME_CLUSTER_6=uniprime_wall_clocks_c6
MONGO_DB_NAME_CLUSTER_7=uniprime_wall_clocks_c7
MONGO_DB_NAME_CLUSTER_8=uniprime_wall_clocks_c8

# --- JWT ---
JWT_SECRET=7fK9lQ2xV8pL4zN6rT1wY5aC9sD3hJ8kP0vB6nX4qR7
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# --- Cookies (production defaults: secure=true, sameSite=strict) ---
# Set COOKIE_SAME_SITE=none (with COOKIE_SECURE=true) only if the frontend
# and API live on different origins (e.g. Vercel front + Render/Railway API).
# Set COOKIE_DOMAIN if you serve the API from a subdomain (e.g. api.example.com).
COOKIE_SAME_SITE=strict
# COOKIE_SECURE=true
# COOKIE_DOMAIN=.example.com

# --- SMTP (use a Gmail App Password, NOT your Gmail password) ---
